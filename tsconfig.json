{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "sourceMap": false,
    "rootDir": "./lib",
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/**/*"
  ]
}
