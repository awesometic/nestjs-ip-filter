{
  "name": "nestjs-ip-filter",
  "version": "0.2.0",
  "description": "A NestJS Guard for filtering IP addresses",
  "author": "Deokgyu Yang <secugyu@gmail.com>",
  "keywords": [
    "nestjs",
    "ip filter",
    "whitelist",
    "blacklist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesometic/nestjs-ip-filter.git"
  },
  "homepage": "https://github.com/awesometic/nestjs-ip-filter",
  "bugs": {
    "url": "https://github.com/awesometic/nestjs-ip-filter/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"{lib,test}/**/*.ts\"",
    "lint": "eslint \"{lib,test}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supercharge/request-ip": "1.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts"
    ],
    "testEnvironment": "node"
  }
}
