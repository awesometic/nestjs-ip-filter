{
  "name": "nestjs-ip-filter",
  "version": "1.0.0",
  "description": "A NestJS Guard for filtering IP addresses",
  "author": "Deokgyu Yang <secugyu@gmail.com>",
  "keywords": [
    "nestjs",
    "ip filter",
    "whitelist",
    "blacklist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesometic/nestjs-ip-filter.git"
  },
  "homepage": "https://github.com/awesometic/nestjs-ip-filter",
  "bugs": {
    "url": "https://github.com/awesometic/nestjs-ip-filter/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"{lib,test}/**/*.ts\" \"scripts/*.mts\"",
    "lint": "eslint \"{lib,test}/**/*.ts\" \"scripts/*.mts\"",
    "test": "rm -rf .test-dist && tsc -p test/tsconfig.json && node --test .test-dist/test/ipfilter.spec.js && tsc -p scripts/tsconfig.json && node --experimental-strip-types --test scripts/github-release.test.mts",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/testing": "12.4.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
